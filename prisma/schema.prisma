generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  primaryEmail String          @unique
  avatarUrl    String?
  studentId    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  googleAccounts GoogleAccount[]
}

model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String
  googleSub    String    @unique
  email        String    @unique
  displayName  String?
  avatarUrl    String?
  accountType  String    @default("PERSONAL") // "PERSONAL" | "HCMUT"
  isPrimary    Boolean   @default(false)
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    BigInt?
  scope        String?   @db.Text
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MyBkAccount {
  id                String    @id @default(cuid())
  studentId         String    @unique
  sinhVienId        Int?
  ssoUsername       String?
  encryptedPassword String?   @db.Text
  jwtToken          String    @db.Text
  tokenExpiresAt    BigInt?
  studentInfoJson   String?   @db.Text
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  semesters      AcademicSemester[]
  courses        AcademicCourseGrade[]
  otherCourses   AcademicOtherGrade[]
  timetableItems AcademicTimetableItem[]
  examItems      AcademicExamItem[]
  notifications  AcademicSyncNotification[]
}

model AcademicSemester {
  id             String   @id @default(cuid())
  studentId      String
  namHocHocKyId  Int
  maNamHocHocKy  String
  namHocHocKyTen String
  soTCTLHocKy    Int      @default(0)
  diemTBTLHocKy  String   @default("0.0")
  soTCTLChung    String   @default("0")
  diemTBTLChung  String   @default("0.0")
  capNhatCuoi    String?
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, maNamHocHocKy])
  @@index([studentId])
}

model AcademicCourseGrade {
  id                  String   @id @default(cuid())
  studentId           String
  namHocHocKyId       Int
  maHocKy             String
  monHocId            Int
  maMonHoc            String
  tenMonHoc           String
  soTinChi            Int      @default(0)
  diemChu             String?
  diemSo              Float?
  diemDat             String?
  tinhTrangDiem       String?
  diemKhongIn         String?
  nhomTo              String?
  ghiChu              String?
  componentScoresJson String?  @db.Text
  isNewUpdate         Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, maHocKy, maMonHoc, monHocId])
  @@index([studentId, maHocKy])
}

model AcademicOtherGrade {
  id          String   @id @default(cuid())
  studentId   String
  maHocKy     String
  maMonHoc    String
  tenMonHoc   String
  diemSo      String?
  diemDat     String?
  ghiChu      String?
  capNhatCuoi String?
  updatedAt   DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, maHocKy, maMonHoc])
  @@index([studentId])
}

model AcademicTimetableItem {
  id                 String   @id @default(cuid())
  studentId          String
  scheduleId         Int
  semesterYearCode   String
  semesterYearName   String
  subjectCode        String
  subjectNameVi      String
  subjectNameEn      String?
  numOfCredits       Int      @default(0)
  classGroup         String?
  employeeName       String?
  employeeEmail      String?
  roomCode           String?
  buildingCode       String?
  buildingNote       String?
  campusCode         String?
  campusNameVi       String?
  calendarYear       Int      @default(2026)
  weeksCalendarBegin Int      @default(35)
  dayOfWeek          Int      @default(0)
  startLesson        Int      @default(0)
  numOfLesson        Int      @default(0)
  startTime          String   @default("0:00")
  endTime            String   @default("0:00")
  weekSeriesDisplay  String   @default("")
  lastUpdatedTime    String?
  courseNote         String?  @db.Text
  updatedAt          DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, scheduleId])
  @@index([studentId, semesterYearCode])
}

model AcademicExamItem {
  id                  String   @id @default(cuid())
  studentId           String
  examId              Int
  semesterYearCode    String
  semesterYearName    String
  academicYear        Int      @default(2026)
  semester            Int      @default(1)
  subjectId           Int?
  subjectCode         String
  subjectName         String
  numOfCredits        Int      @default(0)
  classGroup          String?
  examType            String   @default("CK") // "GK" | "CK" | "THILAI"
  examDate            String   // "YYYY-MM-DD"
  dayOfWeek           Int      @default(0)
  weekNumber          Int      @default(0)
  startLesson         Int      @default(0)
  numOfLesson         Int      @default(0)
  endLesson           Int      @default(0)
  startTimeRaw        String   @default("07g00")
  startTime           String   @default("07:00")
  endTime             String   @default("08:30")
  durationMinutes     Int      @default(60)
  campusCode          String?
  buildingCode        String?
  roomCode            String?
  seatOrder           Int?     // NLMHSV_STT (Số thứ tự danh sách phòng thi)
  gradeDeadline       String?  // NHAPDIEM_DEADLINE (VD: "07/01/2027")
  examNote            String?  // NLMHSV_GHICHU
  personalNote        String?  @db.Text
  prepStatus          String   @default("NOT_STARTED") // "NOT_STARTED" | "STUDYING" | "READY"
  lastUpdatedTime     String?
  updatedAt           DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, examId])
  @@index([studentId, semesterYearCode])
}

model AcademicSyncNotification {
  id           String   @id @default(cuid())
  studentId    String
  category     String   @default("GRADE") // "GRADE" | "EXAM" | "TIMETABLE"
  semesterCode String?
  courseCode   String?
  title        String
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@index([studentId, createdAt])
}
