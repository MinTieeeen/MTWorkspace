generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  name         String
  primaryEmail String          @unique
  avatarUrl    String?
  studentId    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  googleAccounts GoogleAccount[]
}

model GoogleAccount {
  id           String    @id @default(cuid())
  userId       String
  googleSub    String    @unique
  email        String    @unique
  displayName  String?
  avatarUrl    String?
  accountType  String    @default("PERSONAL") // "PERSONAL" | "HCMUT"
  isPrimary    Boolean   @default(false)
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    BigInt?
  scope        String?   @db.Text
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MyBkAccount {
  id                String    @id @default(cuid())
  studentId         String    @unique
  sinhVienId        Int?
  ssoUsername       String?
  encryptedPassword String?   @db.Text
  jwtToken          String    @db.Text
  tokenExpiresAt    BigInt?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  semesters AcademicSemester[]
  courses   AcademicCourseGrade[]
}

model AcademicSemester {
  id             String   @id @default(cuid())
  studentId      String
  namHocHocKyId  Int
  maNamHocHocKy  String
  namHocHocKyTen String
  soTCTLHocKy    Int      @default(0)
  diemTBTLHocKy  String   @default("0.0")
  soTCTLChung    String   @default("0")
  diemTBTLChung  String   @default("0.0")
  capNhatCuoi    String?
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, maNamHocHocKy])
  @@index([studentId])
}

model AcademicCourseGrade {
  id            String   @id @default(cuid())
  studentId     String
  namHocHocKyId Int
  maHocKy       String
  monHocId      Int
  maMonHoc      String
  tenMonHoc     String
  soTinChi      Int      @default(0)
  diemChu       String?
  diemSo        Float?
  diemDat       String?
  tinhTrangDiem String?
  diemKhongIn   String?
  nhomTo        String?
  ghiChu        String?
  updatedAt     DateTime @updatedAt

  account MyBkAccount @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@index([studentId, maHocKy])
}
