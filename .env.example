# Environment Configuration (MTWorkspace)

# PostgreSQL Database Connection (Matches docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mt_workspace
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mt_workspace?schema=public"

# Session Secret
SESSION_SECRET="mt-workspace-local-secret-key-2026"

# myBK Portal Configuration
MYBK_APP_URL="https://mybk.hcmut.edu.vn/app"
MYBK_SSO_URL="https://sso.hcmut.edu.vn"

# Google OAuth 2.0 (Gmail Personal & @hcmut.edu.vn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
